---
import FileHeading from '../components/ui/FileHeading.astro';
import { getSite } from '../lib/content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  subtitle: string;
  /** Frase destacada con borde a la izquierda. */
  lead: string;
  /** Meta description; por defecto, `lead`. */
  description?: string;
  /** Línea mono bajo el subtítulo (fuentes, periodo). */
  context?: string;
  /** Ruta que se muestra como `$ cat …` sobre el título. */
  file: string;
  back: { href: string; label: string };
}

// Páginas internas (caso de estudio, uso de IA): volver, título, bajada y frase; el resto en el slot.
const { title, subtitle, lead, description = lead, context, file, back } = Astro.props;
const { name } = await getSite();
---

<BaseLayout title={`${title} · ${name}`} description={description}>
  <!-- z-[4]: sobre el cielo de estrellas (z-3), como el contenido del home (decisión 014). -->
  <article class="wrap relative z-[4] pt-[clamp(96px,14vh,140px)] pb-24">
    <a href={back.href} class="font-mono text-[0.8rem] text-muted transition-colors hover:text-fg">
      ← {back.label}
    </a>
    <div class="mt-7">
      <FileHeading file={file} />
    </div>
    <h1 class="mt-3.5 mb-2.5 font-display text-[clamp(2.2rem,7vw,4.6rem)] leading-[0.98] font-bold tracking-[-0.045em] text-balance">
      {title}
    </h1>
    <p class="text-[clamp(1.05rem,2.2vw,1.35rem)] font-semibold text-soft">{subtitle}</p>
    {context && <p class="mt-2.5 font-mono text-[0.78rem] leading-[1.4] text-muted">{context}</p>}
    <p class="mt-7 max-w-[62ch] border-l-2 border-c2 pl-4 text-[clamp(1.02rem,1.9vw,1.2rem)]">
      {lead}
    </p>
    <slot />
  </article>
</BaseLayout>
