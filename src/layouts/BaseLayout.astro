---
import '../styles/global.css';
import displayFont from '@fontsource/martian-mono/files/martian-mono-latin-700-normal.woff2?url';
import sansFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import Footer from '../components/layout/Footer.astro';
import IconSprite from '../components/layout/IconSprite.astro';
import Nav from '../components/layout/Nav.astro';
import Reveal from '../components/layout/Reveal.astro';
import Seo from '../components/layout/Seo.astro';
import SmoothScroll from '../components/layout/SmoothScroll.astro';
import StarSky from '../components/layout/StarSky.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <!-- Las fuentes del nombre y del texto: las escenas animadas esperan a que carguen. -->
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} />
  </head>
  <body class="min-h-dvh text-fg">
    <IconSprite />
    <a
      href="#contenido"
      class="fixed top-3 left-3 z-[60] -translate-y-[200%] rounded-full bg-fg px-4 py-2.5 text-sm font-semibold text-bg focus-visible:translate-y-0"
    >
      Saltar al contenido
    </a>
    <!-- z-[1]: el contenido va sobre el cielo de estrellas (StarSky, z-0). -->
    <main id="contenido" tabindex="-1" class="relative z-[1] outline-none">
      <slot />
    </main>
    <Footer />
    <Nav />
    <StarSky />
    <Reveal />
    <SmoothScroll />
  </body>
</html>
