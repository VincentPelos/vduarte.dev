---
import CaseHeading from '../components/case/CaseHeading.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import LinkHint from '../components/ui/LinkHint.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAiUsage } from '../lib/content';
import { linkAttrs } from '../lib/links';

// Declaración de uso de IA (rúbrica: admisibilidad 6). Todo el texto sale de ai-usage.json.
const { title, subtitle, intro, tools, projects, checks, links, labels } = await getAiUsage();
const chip =
  'rounded-full border border-line px-[11px] py-[7px] font-mono text-[0.74rem] leading-none transition-colors hover:border-line-hi';
---

<BaseLayout title={`${title} · Vicente Contreras Duarte`} description={subtitle}>
  <!-- z-[4]: sobre el cielo de estrellas (z-3), como el contenido del home (decisión 014). -->
  <article class="wrap relative z-[4] pt-[clamp(96px,14vh,140px)] pb-24">
    <a href="/" class="font-mono text-[0.8rem] text-muted transition-colors hover:text-fg">
      ← {labels.back}
    </a>
    <div class="mt-7">
      <CaseHeading file="src/content/ai-usage.json" />
    </div>
    <h1 class="mt-3.5 mb-2.5 font-display text-[clamp(2.2rem,7vw,4.6rem)] leading-[0.98] font-bold tracking-[-0.045em] text-balance">
      {title}
    </h1>
    <p class="text-[clamp(1.05rem,2.2vw,1.35rem)] font-semibold text-soft">{subtitle}</p>
    <p class="mt-7 max-w-[62ch] border-l-2 border-c2 pl-4 text-[clamp(1.02rem,1.9vw,1.2rem)]">
      {intro}
    </p>

    <ul class="mt-[34px] grid gap-3 min-[861px]:grid-cols-3">
      {tools.map((tool) => (
        <GlassCard as="li" class="grid content-start gap-2 p-[18px]">
          <span class="font-display text-[clamp(1.15rem,2.5vw,1.5rem)] leading-none font-bold tracking-display">
            {tool.name}
          </span>
          <span class="font-mono text-[0.74rem] leading-[1.3] text-muted">{tool.maker}</span>
          <span class="text-[0.92rem] text-soft">{tool.use}</span>
        </GlassCard>
      ))}
    </ul>

    {projects.map((project) => (
      <section id={project.id} class="mt-[clamp(56px,8vw,90px)]">
        <CaseHeading file={project.file} title={project.title} />
        <ul class="mt-[22px] grid gap-2.5">
          {project.rows.map((row) => (
            <GlassCard
              as="li"
              class="grid gap-x-6 gap-y-2.5 p-[18px] min-[861px]:grid-cols-[150px_1fr_1fr]"
            >
              <span class="font-mono text-[0.82rem] font-medium">{row.task}</span>
              <p class="text-[0.92rem] text-soft">
                <span class="block font-mono text-[0.7rem] text-c1">{labels.ai}</span>
                {row.ai}
              </p>
              <p class="text-[0.92rem]">
                <span class="block font-mono text-[0.7rem] text-c3">{project.decidedBy}</span>
                {row.author}
              </p>
            </GlassCard>
          ))}
        </ul>
      </section>
    ))}

    <section id="verificacion" class="mt-[clamp(56px,8vw,90px)]">
      <CaseHeading file="verificacion.md" title={checks.title} />
      <ul class="mt-4 grid gap-2.5 min-[861px]:grid-cols-2">
        {checks.items.map((item) => (
          <li class="relative rounded-[14px] border border-line py-3.5 pr-4 pl-10 text-soft">
            <span aria-hidden="true" class="absolute top-3.5 left-4 font-mono text-ok">
              ✓
            </span>
            {item}
          </li>
        ))}
      </ul>
      <nav aria-label={labels.links} class="mt-5 flex flex-wrap gap-1.5">
        {links.map((link) => (
          <a href={link.href} {...linkAttrs(link.href)} class={chip}>
            {link.label} ↗
            <LinkHint href={link.href} />
          </a>
        ))}
      </nav>
    </section>
  </article>
</BaseLayout>
