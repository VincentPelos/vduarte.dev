---
import { getCollection } from 'astro:content';
import CaseBlock from '../../components/case/CaseBlock.astro';
import CaseDashboard from '../../components/case/CaseDashboard.astro';
import CaseHeading from '../../components/case/CaseHeading.astro';
import GlassCard from '../../components/ui/GlassCard.astro';
import LinkHint from '../../components/ui/LinkHint.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { linkAttrs } from '../../lib/links';

// Una página por caso de estudio de cases.json (el `caseStudy` de un proyecto): /proyectos/<id>.
export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { data: entry.data } }));
}

const { data } = Astro.props;
const { title, subtitle, context, question, stats, blocks, conclusions, limitations } = data;
const { process, resources, labels } = data;
const chip =
  'rounded-full border border-line px-[11px] py-[7px] font-mono text-[0.74rem] leading-none transition-colors hover:border-line-hi';
---

<BaseLayout title={`${title} · Vicente Contreras Duarte`} description={question}>
  <!-- z-[4]: sobre el cielo de estrellas (z-3), como el contenido del home (decisión 014). -->
  <article class="wrap relative z-[4] pt-[clamp(96px,14vh,140px)] pb-24">
    <a
      href="/#proyectos"
      class="font-mono text-[0.8rem] text-muted transition-colors hover:text-fg"
    >
      ← {labels.back}
    </a>
    <div class="mt-7">
      <CaseHeading file="src/content/cases.json" />
    </div>
    <h1 class="mt-3.5 mb-2.5 font-display text-[clamp(2.2rem,7vw,4.6rem)] leading-[0.98] font-bold tracking-[-0.045em] text-balance">
      {title}
    </h1>
    <p class="text-[clamp(1.05rem,2.2vw,1.35rem)] font-semibold text-soft">{subtitle}</p>
    <p class="mt-2.5 font-mono text-[0.78rem] leading-[1.4] text-muted">{context}</p>
    <p class="mt-7 max-w-[62ch] border-l-2 border-c2 pl-4 text-[clamp(1.02rem,1.9vw,1.2rem)]">
      {question}
    </p>

    <ul class="mt-[34px] grid grid-cols-2 gap-3 min-[861px]:grid-cols-4">
      {stats.map((stat) => (
        <GlassCard as="li" class="grid content-start gap-2 p-[18px]">
          <span class="font-display text-[clamp(1.15rem,2.5vw,1.9rem)] leading-none font-bold tracking-display whitespace-nowrap">
            {stat.value}
          </span>
          <span class="text-[0.86rem] leading-[1.4] text-muted">{stat.label}</span>
        </GlassCard>
      ))}
    </ul>

    <CaseDashboard data={data} />

    {blocks.map((block) => (
      <CaseBlock block={block} />
    ))}

    <section id="que-hacer" class="mt-[clamp(56px,8vw,90px)]">
      <CaseHeading file="conclusiones.md" title={conclusions.title} />
      <GlassCard as="div" class="mt-[22px] p-6 text-[clamp(1.02rem,1.9vw,1.18rem)]">
        {conclusions.answer}
      </GlassCard>
      <ul class="mt-4 grid gap-2.5 min-[861px]:grid-cols-2">
        {conclusions.actions.map((action) => (
          <li class="relative rounded-[14px] border border-line py-3.5 pr-4 pl-10 text-soft">
            <span aria-hidden="true" class="absolute top-3.5 left-4 font-mono text-c1">
              →
            </span>
            {action}
          </li>
        ))}
      </ul>
    </section>

    <section id="limites" class="mt-[clamp(56px,8vw,90px)]">
      <CaseHeading file="limites.md" title={limitations.title} />
      <ul class="mt-4 grid gap-2">
        {limitations.items.map((item) => (
          <li class="relative pl-[18px] text-[0.92rem] text-soft">
            <span aria-hidden="true" class="absolute left-0 font-mono text-c3">
              !
            </span>
            <strong class="font-semibold text-fg">{item.title}.</strong> {item.body}
          </li>
        ))}
      </ul>
    </section>

    <section id="como-se-hizo" class="mt-[clamp(56px,8vw,90px)]">
      <CaseHeading file="proceso.md" />
      <GlassCard as="div" class="mt-3 grid gap-3 px-[18px] py-4">
        <p>
          <strong class="font-semibold">{process.title}:</strong>
          <span class="text-soft">{process.text}</span>
        </p>
        <nav aria-label={labels.notebooks} class="flex flex-wrap gap-1.5">
          {resources.notebooks.map((notebook) => (
            <a href={notebook.href} {...linkAttrs(notebook.href)} class={chip}>
              {notebook.title} ↗
              <LinkHint href={notebook.href} />
            </a>
          ))}
          <a href={resources.repo} {...linkAttrs(resources.repo)} class={chip}>
            {labels.repo} ↗
            <LinkHint href={resources.repo} />
          </a>
        </nav>
      </GlassCard>
    </section>
  </article>
</BaseLayout>
