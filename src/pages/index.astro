---
import About from '../components/sections/about/About.astro';
import Contact from '../components/sections/contact/Contact.astro';
import Education from '../components/sections/education/Education.astro';
import Experience from '../components/sections/experience/Experience.astro';
import Hero from '../components/sections/hero/Hero.astro';
import Projects from '../components/sections/projects/Projects.astro';
import Skills from '../components/sections/skills/Skills.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Hero />
  <!--
    Hoja del portafolio (decisión 014): sube sobre el hero quieto. Capas: hero (z-1) < fondo de la
    hoja (z-2) < cielo de estrellas (z-3, StarSky) < contenido (z-4). [data-hero-end] marca el borde
    de la hoja: cuando pasa arriba de la pantalla, el hero quedó tapado.
  -->
  <div class="relative">
    <div data-hero-end aria-hidden="true" class="absolute top-0 h-px w-full"></div>
    <div
      aria-hidden="true"
      class="absolute inset-0 z-[2] rounded-t-[28px] border-t border-line-hi bg-bg shadow-[0_-30px_60px_rgb(0_0_0/0.8)]"
    ></div>
    <div class="relative z-[4]">
      <About />
      <Experience />
      <Projects />
      <Education />
      <Skills />
      <Contact />
    </div>
  </div>
</BaseLayout>
