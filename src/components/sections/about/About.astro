---
import { getCollection } from 'astro:content';
import { getCase, getSite } from '../../../lib/content';
import Glows from '../../ui/Glows.astro';
import AreaCard from './cards/AreaCard.astro';
import BioCard from './cards/BioCard.astro';
import LinksCard from './cards/LinksCard.astro';
import StackCard from './cards/StackCard.astro';
import StatusCard from './cards/StatusCard.astro';

const site = await getSite();
const { bento, labels } = site;

// El ícono de cada tecnología del stack sale de skills.json, buscando por nombre.
const icons = new Map(
  (await getCollection('skills')).flatMap((entry) =>
    entry.data.items.map((item) => [item.name, item.icon] as const),
  ),
);
const stack = site.highlightStack.map((name) => ({ name, icon: icons.get(name) }));

// El dibujo de ~/datos son las barras reales del caso: la superficie frutal de Colchagua.
const chart = (await getCase('colchagua')).blocks
  .flatMap((block) => block.panels)
  .find((panel) => panel.chart.type === 'pairs')?.chart;
const surface = chart?.type === 'pairs' ? chart.items.map((item) => item.after) : undefined;
---

<section
  id="sobre-mi"
  data-bento
  aria-label={bento.about}
  class="relative pt-[clamp(48px,8vw,80px)] pb-[clamp(72px,12vw,140px)]"
>
  <!-- Sin isolate ni recorte: los brillos se extienden detrás de Experiencia. No suben sobre el
       hero: la hoja que lo tapa empieza aquí (decisión 014). -->
  <Glows class="top-0 bottom-[-35%]" />
  <div class="wrap">
    <!--
      Bento (#133): la frase y el estado; las cuatro áreas, cada una con su dibujo en puntos y un
      enlace a su prueba; el stack en logos y los enlaces. Dos columnas hasta 900px (en celular,
      de a dos por fila para acortar el scroll) y cuatro desde 901px. Las tarjetas llevan el vidrio
      a la mitad (elegido en el laboratorio): se ven más los brillos de atrás.
    -->
    <div
      data-bento-grid
      class="grid grid-cols-2 gap-3 *:backdrop-blur-[10px] *:backdrop-saturate-[135%] *:[background:linear-gradient(color-mix(in_srgb,var(--color-glass)_50%,transparent),color-mix(in_srgb,var(--color-glass)_50%,transparent)),color-mix(in_srgb,var(--color-bg)_15%,transparent)] [grid-template-areas:'bio_bio'_'dev_datos'_'infra_agentes'_'status_links'_'stack_stack'] max-[460px]:gap-2.5 min-[901px]:grid-cols-4 min-[901px]:[grid-template-areas:'bio_bio_bio_status'_'dev_datos_infra_agentes'_'stack_stack_stack_links']"
    >
      <BioCard
        label={bento.about}
        title={site.bioTitle}
        bio={site.bio}
        github={site.github}
        githubLabel={labels.github}
        cvPath={site.cvPath}
        cvLabel={labels.cv}
        pendingLabel={labels.pending}
      />
      <StatusCard
        label={bento.status}
        text={site.available ? bento.available : bento.unavailable}
        available={site.available}
        note={site.availabilityNote}
      />
      {bento.areas.map((area) => (
        <AreaCard {...area} values={area.art === 'datos' ? surface : undefined} />
      ))}
      <StackCard label={bento.stack} items={stack} />
      <LinksCard
        label={bento.links}
        pendingLabel={labels.pending}
        links={[
          { href: site.github, text: labels.github },
          { href: site.linkedin, text: labels.linkedin },
          { href: site.cvPath, text: labels.cv, download: true },
        ]}
      />
    </div>
  </div>
  <!-- Donde los puntos del agujero dibujan el bento al terminar la caída (bento-assemble.ts). -->
  <canvas
    data-bento-fx
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-10 hidden size-full"
  ></canvas>
</section>

<script>
  import { whenIdle } from '../../../lib/scene';

  const section = document.querySelector<HTMLElement>('[data-bento]');
  if (section) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Los dibujos de las áreas se cargan diferidos; sin JS las tarjetas se ven igual, sin dibujo.
    whenIdle(() =>
      import('./bento-art')
        .then(({ mountArt }) => mountArt(section, { reducedMotion }))
        .catch(() => {}),
    );
    // El armado solo existe si hay caída (decisión 018), que no se monta con movimiento reducido.
    if (!reducedMotion)
      import('./bento-assemble')
        .then(({ mountAssemble }) => mountAssemble(section))
        .catch(() => {});
  }
</script>
