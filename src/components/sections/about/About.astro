---
import { getCollection, getEntry } from 'astro:content';
import Glows from '../../ui/Glows.astro';
import BioCard from './cards/BioCard.astro';
import ClockCard from './cards/ClockCard.astro';
import GamingCard from './cards/GamingCard.astro';
import LinksCard from './cards/LinksCard.astro';
import PlayingCard from './cards/PlayingCard.astro';
import StackCard from './cards/StackCard.astro';
import StatusCard from './cards/StatusCard.astro';

const site = await getEntry('site', 'main');
if (!site) throw new Error('Falta la entrada "main" en src/content/site.json');

const data = site.data;
const { bento } = data;

// El ícono de cada tecnología del stack sale de skills.json, buscando por nombre.
const icons = new Map(
  (await getCollection('skills')).flatMap((entry) =>
    entry.data.items.map((item) => [item.name, item.icon] as const),
  ),
);
const stack = data.highlightStack.map((name) => ({ name, icon: icons.get(name) }));
---

<section id="sobre-mi" aria-label={bento.about} class="relative pt-2 pb-[clamp(72px,12vw,140px)]">
  <!-- Sin isolate ni recorte: los brillos se extienden detrás del hero y de Experiencia. -->
  <Glows class="top-[-35%] bottom-[-35%]" />
  <div class="wrap">
    <!-- 1 columna → 2 desde 461px → 4 desde 901px, como en la guía. -->
    <div class="grid grid-cols-1 gap-3 [grid-template-areas:'bio'_'status'_'clock'_'stack'_'play'_'game'_'links'] min-[461px]:auto-rows-[minmax(150px,auto)] min-[461px]:grid-cols-2 min-[461px]:[grid-template-areas:'bio_bio'_'clock_status'_'stack_stack'_'play_play'_'game_links'] min-[901px]:grid-cols-4 min-[901px]:[grid-template-areas:'bio_bio_clock_status'_'bio_bio_stack_stack'_'play_play_game_links']">
      <BioCard label={bento.about} title={data.bioTitle} bio={data.bio} />
      <ClockCard label={bento.clock} timezone={data.timezone} location={data.location} />
      <StatusCard
        label={bento.status}
        text={data.available ? bento.available : bento.unavailable}
        available={data.available}
        note={data.availabilityNote}
      />
      <StackCard label={bento.stack} items={stack} />
      <PlayingCard label={bento.playing} {...data.nowPlaying} />
      <GamingCard label={bento.gaming} {...data.nowGaming} />
      <LinksCard
        label={bento.links}
        pendingLabel={data.labels.pending}
        links={[
          { href: data.github, text: data.labels.github },
          { href: data.linkedin, text: data.labels.linkedin },
        ]}
      />
    </div>
  </div>
</section>
