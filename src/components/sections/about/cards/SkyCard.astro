---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<!--
  Ventana chica donde las estrellas forman la constelación de Sobre mí (decisión 009).
  Sin vidrio difuminado: el desenfoque borraría las estrellas que se ven a través.
-->
<article class="flex min-w-0 flex-col gap-3 rounded-card border border-line bg-glass/40 p-[22px] [grid-area:sky]">
  <p class="label normal-case">{label}</p>
  <div data-constellation="about" aria-hidden="true" class="min-h-[84px] flex-1"></div>
</article>
