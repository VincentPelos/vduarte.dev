---
import { linkAttrs } from '../../../../lib/links';
import BentoCard from '../BentoCard.astro';

interface Props {
  label: string;
  pendingLabel: string;
  links: { href?: string; text: string }[];
}

const { label, pendingLabel, links } = Astro.props;
---

<BentoCard label={label} class="justify-between [grid-area:links]">
  <div>
    {links.map(({ href, text }) =>
      href ? (
        <a
          href={href}
          {...linkAttrs(href)}
          class="flex items-center justify-between border-t border-line py-2 font-medium transition-colors hover:text-white"
        >
          {text}
          <span aria-hidden="true" class="font-mono text-muted">
            ↗
          </span>
        </a>
      ) : (
        <span
          role="link"
          aria-disabled="true"
          title={pendingLabel}
          class="flex items-center justify-between border-t border-line py-2 font-medium text-muted"
        >
          {text}
          <span aria-hidden="true" class="font-mono">
            ↗
          </span>
        </span>
      ),
    )}
  </div>
</BentoCard>
