---
import TechIcon from '../../../ui/TechIcon.astro';
import BentoCard from '../BentoCard.astro';

interface Props {
  label: string;
  /** `icon` viene de skills.json; si la tecnología no está ahí, se muestra una abreviatura. */
  items: { name: string; icon?: string }[];
}

const { label, items } = Astro.props;
---

<BentoCard label={label} class="[grid-area:stack]">
  <ul class="flex flex-wrap gap-2">
    {items.map(({ name, icon }) => (
      <li class="inline-flex items-center gap-2 rounded-full border border-line bg-glass px-3 py-2 text-[0.88rem] leading-none">
        <span aria-hidden="true" class="grid size-[18px] place-items-center text-[0.95rem]">
          <TechIcon name={name} icon={icon} fallbackClass="text-[0.55rem]" />
        </span>
        {name}
      </li>
    ))}
  </ul>
</BentoCard>
