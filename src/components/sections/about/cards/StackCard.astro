---
import GlassCard from '../../../ui/GlassCard.astro';

interface Props {
  label: string;
  items: string[];
}

const { label, items } = Astro.props;
---

<GlassCard class="flex min-w-0 flex-col gap-3 p-[22px] [grid-area:stack]">
  <p class="label">{label}</p>
  <ul class="flex flex-wrap gap-2">
    {items.map((item) => (
      <li class="inline-flex items-center gap-2 rounded-full border border-line bg-glass px-3 py-2 text-[0.88rem] leading-none">
        {/* Abreviatura provisional: los íconos llegan con la decisión 007 (#42). */}
        <span
          aria-hidden="true"
          class="grid size-[18px] place-items-center rounded-[5px] bg-line-hi font-mono text-[0.55rem] leading-none font-semibold"
        >
          {item.slice(0, 2)}
        </span>
        {item}
      </li>
    ))}
  </ul>
</GlassCard>
