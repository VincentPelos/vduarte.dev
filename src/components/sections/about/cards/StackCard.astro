---
import GlassCard from '../../../ui/GlassCard.astro';
import Icon from '../../../ui/Icon.astro';

interface Props {
  label: string;
  /** `icon` viene de skills.json; si la tecnología no está ahí, se muestra una abreviatura. */
  items: { name: string; icon?: string }[];
}

const { label, items } = Astro.props;
---

<GlassCard class="flex min-w-0 flex-col gap-3 p-[22px] [grid-area:stack]">
  <p class="label">{label}</p>
  <ul class="flex flex-wrap gap-2">
    {items.map(({ name, icon }) => (
      <li class="inline-flex items-center gap-2 rounded-full border border-line bg-glass px-3 py-2 text-[0.88rem] leading-none">
        <span aria-hidden="true" class="grid size-[18px] place-items-center text-[0.95rem]">
          {icon ? (
            <Icon name={icon} />
          ) : (
            <span class="font-mono text-[0.55rem] font-semibold">{name.slice(0, 2)}</span>
          )}
        </span>
        {name}
      </li>
    ))}
  </ul>
</GlassCard>
