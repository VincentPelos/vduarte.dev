---
import GlassCard from '../../../ui/GlassCard.astro';

interface Props {
  label: string;
  title: string;
  bio: string;
}

const { label, title, bio } = Astro.props;
---

<GlassCard class="flex min-w-0 flex-col justify-between gap-3 p-[22px] [grid-area:bio]">
  <p class="label">{label}</p>
  <h2 class="max-w-[22ch] text-[clamp(1.4rem,3vw,2rem)] leading-[1.2] font-semibold tracking-[-0.02em] text-balance">
    {title}
  </h2>
  <p class="max-w-[52ch] text-muted">{bio}</p>
</GlassCard>
