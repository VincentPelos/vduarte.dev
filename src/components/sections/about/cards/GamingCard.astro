---
import GlassCard from '../../../ui/GlassCard.astro';

interface Props {
  label: string;
  title: string;
  hours?: number;
  note?: string;
  gacha?: { game: string; pity: number; pityMax: number };
}

const { label, title, hours, note, gacha } = Astro.props;
const meta = [hours !== undefined && `${hours} h`, note].filter(Boolean).join(' · ');
---

<GlassCard class="flex min-w-0 flex-col justify-between gap-3 p-[22px] [grid-area:game]">
  <p class="label">{label}</p>
  <div>
    <p class="text-[1.15rem] leading-[1.25] font-semibold">{title}</p>
    {meta && <p class="mt-1 font-mono text-[0.82rem] leading-none text-muted">{meta}</p>}
  </div>
  {gacha && (
    <div class="flex items-center justify-between gap-2 border-t border-line pt-2.5">
      <span aria-hidden="true" class="text-grad tracking-[0.1em]">
        ★★★★★
      </span>
      <span class="font-mono text-[0.82rem] leading-none text-muted" title={gacha.game}>
        pity {gacha.pity}/{gacha.pityMax}
      </span>
    </div>
  )}
</GlassCard>
