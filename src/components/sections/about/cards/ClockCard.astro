---
import GlassCard from '../../../ui/GlassCard.astro';

interface Props {
  label: string;
  timezone: string;
  location: string;
}

const { label, timezone, location } = Astro.props;
---

<GlassCard class="flex min-w-0 flex-col justify-between gap-3 p-[22px] [grid-area:clock]">
  <p class="label">{label}</p>
  <div>
    <!-- Sin JS queda en --:--: la hora depende del momento de la visita, no del build. -->
    <time
      data-clock
      data-timezone={timezone}
      class="block font-mono text-[clamp(1.8rem,4vw,2.6rem)] leading-none font-medium tracking-[-0.03em] tabular-nums"
    >
      --:--
    </time>
    <p class="mt-1 text-[0.9rem] text-muted">{location}</p>
  </div>
</GlassCard>

<script>
  import { formatTime } from '../../../../lib/time';

  document.querySelectorAll<HTMLElement>('[data-clock]').forEach((el) => {
    const timezone = el.dataset.timezone ?? 'UTC';
    const tick = () => {
      el.textContent = formatTime(new Date(), timezone);
    };
    tick();
    setInterval(tick, 15_000);
  });
</script>
