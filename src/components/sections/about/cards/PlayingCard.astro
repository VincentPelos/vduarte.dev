---
import GlassCard from '../../../ui/GlassCard.astro';

interface Props {
  label: string;
  song: string;
  artist: string;
  album?: string;
}

const { label, song, artist, album } = Astro.props;

// Portada provisional con la paleta; una integración musical real queda para después.
const cover =
  'conic-gradient(from 210deg, var(--color-c3), var(--color-c2), var(--color-c1), var(--color-c3))';
const bars = [
  'h-[40%]',
  'h-[90%] [animation-delay:-0.3s]',
  'h-[60%] [animation-delay:-0.6s]',
  'h-[80%] [animation-delay:-0.15s]',
];
---

<GlassCard class="isolate flex min-w-0 flex-row items-center gap-[18px] p-[22px] [grid-area:play]">
  <div
    aria-hidden="true"
    class="absolute -inset-[30%] -z-10 blur-[70px]"
    style={`background: ${cover}; opacity: calc(0.5 * var(--glow));`}
  ></div>
  <div
    aria-hidden="true"
    class="aspect-square w-[clamp(84px,14vw,116px)] flex-none rounded-[10px] shadow-[0_12px_30px_rgb(0_0_0/0.5)]"
    style={`background: radial-gradient(circle at 30% 30%, var(--color-line-hi), transparent 40%), ${cover};`}
  ></div>
  <div class="grid min-w-0 gap-1">
    <p class="label flex items-end">
      <span aria-hidden="true" class="mr-2 inline-flex h-3.5 items-end gap-[3px]">
        {bars.map((bar) => (
          <i class:list={['w-[3px] animate-eq rounded-[1px] bg-fg', bar]} />
        ))}
      </span>
      {label}
    </p>
    <p class="text-[1.15rem] leading-[1.25] font-semibold">{song}</p>
    <p class="text-muted">{[artist, album].filter(Boolean).join(' · ')}</p>
  </div>
</GlassCard>
