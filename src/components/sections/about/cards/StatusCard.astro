---
import { getSite } from '../../../../lib/content';
import BentoCard from './BentoCard.astro';

const { bento, available, availabilityNote } = await getSite();
---

<BentoCard label={bento.status} class="justify-between [grid-area:status]">
  <p class="flex items-center gap-2.5 text-xl leading-[1.25] font-semibold">
    <span
      aria-hidden="true"
      class:list={[
        'size-2.5 rounded-full',
        available
          ? 'relative bg-ok after:absolute after:inset-0 after:animate-pulse-ok after:rounded-full after:bg-ok/55'
          : 'bg-muted',
      ]}
    ></span>
    {available ? bento.available : bento.unavailable}
  </p>
  {availabilityNote && <p class="text-[0.9rem] text-muted">{availabilityNote}</p>}
</BentoCard>
