---
import BentoCard from '../BentoCard.astro';

interface Props {
  label: string;
  text: string;
  available: boolean;
  note?: string;
}

const { label, text, available, note } = Astro.props;
---

<BentoCard label={label} class="justify-between [grid-area:status]">
  <p class="flex items-center gap-2.5 text-xl leading-[1.25] font-semibold">
    <span
      aria-hidden="true"
      class:list={['size-2.5 rounded-full', available ? 'animate-pulse-ok bg-ok' : 'bg-muted']}
    ></span>
    {text}
  </p>
  {note && <p class="text-[0.9rem] text-muted">{note}</p>}
</BentoCard>
