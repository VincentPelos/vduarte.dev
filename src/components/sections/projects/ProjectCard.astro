---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getSite } from '../../../lib/content';
import Chip from '../../ui/Chip.astro';
import GlassCard from '../../ui/GlassCard.astro';
import ProjectGallery from './ProjectGallery.astro';
import ProjectLinks from './ProjectLinks.astro';

interface Props {
  project: CollectionEntry<'projects'>['data'];
}

const { project } = Astro.props;
const { id, title, description, tags, image, year, featured } = project;
const texts = (await getSite()).sections.projects;
const galleryLabels = texts.gallery;
// El schema pone `gallery: []` por defecto; el respaldo cubre un caché de contenido viejo en dev.
const gallery = project.gallery ?? [];
// Con 2 o más imágenes, la portada abre el visor (ProjectGallery).
const hasGallery = gallery.length > 1;
// Ancho real de la portada: tres columnas dentro de `wrap` (máx. 1200px, ~365px cada una).
const sizes = '(min-width: 1200px) 365px, (min-width: 861px) 30vw, (min-width: 561px) 50vw, 85vw';

const grid =
  'linear-gradient(var(--color-glass-hi) 1px, transparent 1px) 0 0 / 22px 22px, linear-gradient(90deg, var(--color-glass-hi) 1px, transparent 1px) 0 0 / 22px 22px';
const glow =
  'radial-gradient(60% 80% at 25% 30%, color-mix(in srgb, var(--color-c1) calc(30% * var(--glow)), transparent), transparent 70%), radial-gradient(60% 80% at 80% 70%, color-mix(in srgb, var(--color-c3) calc(26% * var(--glow)), transparent), transparent 70%)';
---

{/* Tarjeta de un destacado (#107): imagen de 160 px, relleno compacto, descripción a 3 líneas. */}
<GlassCard class="group grid grid-rows-[auto_1fr]">
  {hasGallery ? (
    <button
      type="button"
      data-gallery-open={id}
      aria-label={`${galleryLabels.open} ${title} (${gallery.length})`}
      class="relative block h-40 w-full cursor-zoom-in overflow-hidden border-b border-line focus-visible:outline-offset-[-2px]"
    >
      <Image
        src={gallery[0].image}
        alt=""
        widths={[400, 600, 800, 1200]}
        sizes={sizes}
        class="absolute inset-0 size-full object-cover transition-transform duration-600 ease-out-expo group-hover:scale-[1.04]"
      />
      <span
        aria-hidden="true"
        class="absolute right-2.5 bottom-2.5 rounded-full border border-line-hi bg-nav px-2.5 py-1.5 font-mono text-[0.7rem] leading-none text-fg backdrop-blur-md"
      >
        ⧉ {gallery.length}
      </span>
    </button>
  ) : (
    <div class="relative h-40 max-w-full overflow-hidden border-b border-line">
      {image ? (
        <Image
          src={image}
          alt=""
          widths={[400, 600, 800, 1200]}
          sizes={sizes}
          class="absolute inset-0 size-full object-cover transition-transform duration-600 ease-out-expo group-hover:scale-[1.04]"
        />
      ) : (
        <div
          aria-hidden="true"
          class="absolute inset-0 transition-transform duration-600 ease-out-expo group-hover:scale-[1.04]"
          style={`background: ${featured ? `${grid}, ${glow}` : grid};`}
        />
      )}
    </div>
  )}
  <div class="grid content-start gap-2.5 px-[13px] pt-3 pb-[13px]">
    <p class="flex justify-between gap-3 font-mono text-[0.74rem] leading-none text-muted tabular-nums">
      <span>{year}</span>
      {featured && <span>★ {texts.featured.one}</span>}
    </p>
    <h3
      class:list={[
        'font-display leading-[1.15] font-bold tracking-[-0.035em]',
        featured ? 'text-[1.7rem]' : 'text-[1.3rem]',
      ]}
    >
      {title}
    </h3>
    <p class="line-clamp-3 text-soft">{description}</p>
    {tags.length > 0 && (
      <ul class="mt-0.5 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <Chip>{tag}</Chip>
        ))}
      </ul>
    )}
    <ProjectLinks project={project} class="mt-1.5" />
  </div>
</GlassCard>
{hasGallery && <ProjectGallery id={id} title={title} images={gallery} labels={galleryLabels} />}
