---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { linkAttrs } from '../../../lib/links';
import Chip from '../../ui/Chip.astro';
import GlassCard from '../../ui/GlassCard.astro';

interface Props {
  project: CollectionEntry<'projects'>['data'];
  labels: { featured: string; repo: string; demo: string; caseStudy: string };
}

const { project, labels } = Astro.props;
const { title, description, tags, image, repo, demo, year, featured, caseStudy } = project;

const grid =
  'linear-gradient(var(--color-glass-hi) 1px, transparent 1px) 0 0 / 22px 22px, linear-gradient(90deg, var(--color-glass-hi) 1px, transparent 1px) 0 0 / 22px 22px';
const glow =
  'radial-gradient(60% 80% at 25% 30%, color-mix(in srgb, var(--color-c1) calc(30% * var(--glow)), transparent), transparent 70%), radial-gradient(60% 80% at 80% 70%, color-mix(in srgb, var(--color-c3) calc(26% * var(--glow)), transparent), transparent 70%)';

const links = [
  caseStudy && { href: `/proyectos/${caseStudy}`, text: `${labels.caseStudy} →` },
  repo && { href: repo, text: `${labels.repo} ↗` },
  demo && { href: demo, text: `${labels.demo} ↗` },
].filter((link) => !!link);
---

<GlassCard class:list={['group grid grid-rows-[auto_1fr]', featured && 'min-[561px]:col-span-2']}>
  <div
    class:list={[
      'relative max-w-full overflow-hidden border-b border-line',
      featured ? 'aspect-video' : 'aspect-[4/3]',
    ]}
  >
    {image ? (
      <Image
        src={image}
        alt=""
        widths={[400, 800, 1200]}
        sizes="(min-width: 861px) 66vw, 100vw"
        class="absolute inset-0 size-full object-cover transition-transform duration-600 ease-out-expo group-hover:scale-[1.04]"
      />
    ) : (
      <div
        aria-hidden="true"
        class="absolute inset-0 transition-transform duration-600 ease-out-expo group-hover:scale-[1.04]"
        style={`background: ${featured ? `${grid}, ${glow}` : grid};`}
      />
    )}
  </div>
  <div class="grid content-start gap-2.5 px-[22px] pt-5 pb-[22px]">
    <p class="flex justify-between gap-3 font-mono text-[0.74rem] leading-none text-muted tabular-nums">
      <span>{year}</span>
      {featured && <span>★ {labels.featured}</span>}
    </p>
    <h3
      class:list={[
        'font-display leading-[1.15] font-bold tracking-[-0.035em]',
        featured ? 'text-[1.7rem]' : 'text-[1.3rem]',
      ]}
    >
      {title}
    </h3>
    <p class="text-soft">{description}</p>
    {tags.length > 0 && (
      <ul class="mt-0.5 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <Chip>{tag}</Chip>
        ))}
      </ul>
    )}
    {links.length > 0 && (
      <p class="mt-1.5 flex flex-wrap gap-[18px] font-mono text-[0.82rem] leading-none font-medium">
        {links.map(({ href, text }) => (
          <a
            href={href}
            {...linkAttrs(href)}
            class="border-b border-line-hi pb-[3px] transition-colors hover:border-fg"
          >
            {text}
          </a>
        ))}
      </p>
    )}
  </div>
</GlassCard>
