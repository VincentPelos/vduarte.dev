---
import { getCollection } from 'astro:content';
import { getSite } from '../../../lib/content';
import { pluralize } from '../../../lib/text';
import { sortProjects } from '../../../lib/projects';
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';

const site = await getSite();

const texts = site.sections.projects;
const projects = sortProjects((await getCollection('projects')).map((entry) => entry.data));
const featured = projects.filter((project) => project.featured).length;
const meta = [
  pluralize(projects.length, texts.unit),
  featured > 0 && pluralize(featured, texts.featured),
]
  .filter(Boolean)
  .join(' · ');
---

<Section id="proyectos" constellation="projects" class="relative isolate">
  <SectionHeader file="projects.json" title={texts.title} meta={meta} constellation="projects" />
  <!--
    Celular (#92): un carrusel que se desliza de lado. Desde 561px, grilla: los destacados ocupan
    doble ancho y dense rellena los huecos.
  -->
  <div
    data-rail
    class="-mx-4 grid snap-x *:snap-start snap-mandatory auto-cols-[84%] grid-flow-col gap-3 overflow-x-auto scroll-px-4 px-4 [scrollbar-width:none] min-[561px]:mx-0 min-[561px]:grid-flow-dense min-[561px]:grid-cols-2 min-[561px]:overflow-visible min-[561px]:px-0 min-[861px]:grid-cols-3"
  >
    {projects.map((project) => (
      <ProjectCard
        project={project}
        labels={{
          featured: texts.featured.one,
          repo: texts.repo,
          demo: texts.demo,
          caseStudy: texts.caseStudy,
        }}
      />
    ))}
  </div>
</Section>
