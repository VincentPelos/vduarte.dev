---
import { getCollection } from 'astro:content';
import { getSite } from '../../../lib/content';
import { pluralize } from '../../../lib/text';
import { sortProjects } from '../../../lib/projects';
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectRow from './ProjectRow.astro';

const site = await getSite();

const texts = site.sections.projects;
const projects = sortProjects((await getCollection('projects')).map((entry) => entry.data));
const featured = projects.filter((project) => project.featured);
const rest = projects.filter((project) => !project.featured);
const links = { repo: texts.repo, demo: texts.demo, caseStudy: texts.caseStudy };
const meta = [
  pluralize(projects.length, texts.unit),
  featured.length > 0 && pluralize(featured.length, texts.featured),
]
  .filter(Boolean)
  .join(' · ');
---

<Section id="proyectos" constellation="projects" class="relative isolate">
  <SectionHeader file="projects.json" title={texts.title} meta={meta} constellation="projects" />
  <!--
    Destacados (#107): tarjetas en una fila (2 columnas desde 561px, 3 desde 861px). En celular, un
    carrusel con 1,2 tarjetas a la vista que se detiene en cada una. Los demás, en una lista.
  -->
  <div
    data-rail
    class="-mx-4 grid snap-x snap-mandatory auto-cols-[82%] grid-flow-col gap-3 overflow-x-auto scroll-px-4 px-4 [scrollbar-width:none] *:snap-start min-[561px]:mx-0 min-[561px]:grid-flow-row min-[561px]:grid-cols-2 min-[561px]:overflow-visible min-[561px]:px-0 min-[861px]:grid-cols-3"
  >
    {featured.map((project) => (
      <ProjectCard
        project={project}
        labels={{ ...links, featured: texts.featured.one }}
        gallery={texts.gallery}
      />
    ))}
  </div>
  {rest.length > 0 && (
    <ul class="mt-3 border-t border-line">
      {rest.map((project) => (
        <ProjectRow project={project} labels={links} />
      ))}
    </ul>
  )}
</Section>
