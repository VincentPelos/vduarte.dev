---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getSite, getSkillIcons } from '../../../lib/content';
import GlassCard from '../../ui/GlassCard.astro';
import Icon from '../../ui/Icon.astro';
import ProjectGallery from './ProjectGallery.astro';
import ProjectLinks from './ProjectLinks.astro';
import ProjectPipeline from './ProjectPipeline.astro';

interface Props {
  project: CollectionEntry<'projects'>['data'];
  hidden?: boolean;
  class?: string;
}

const { project, hidden, class: className } = Astro.props;
const { id, title, description, image, year, featured, skills } = project;
const texts = (await getSite()).sections.projects;
const icons = await getSkillIcons();
// El schema pone `gallery: []` por defecto; el respaldo cubre un caché de contenido viejo en dev.
const gallery = project.gallery ?? [];
// Con 2 o más imágenes, la portada abre el visor (ProjectGallery).
const hasGallery = gallery.length > 1;
const cover = hasGallery ? gallery[0].image : image;
// Ancho real de la portada: la columna derecha (7/12 de `wrap`) desde 861px; antes, todo el ancho.
const sizes = '(min-width: 1200px) 660px, (min-width: 861px) 56vw, 100vw';

const grid =
  'linear-gradient(var(--color-glass-hi) 1px, transparent 1px) 0 0 / 22px 22px, linear-gradient(90deg, var(--color-glass-hi) 1px, transparent 1px) 0 0 / 22px 22px, radial-gradient(60% 80% at 25% 30%, color-mix(in srgb, var(--color-c1) calc(30% * var(--glow)), transparent), transparent 70%), radial-gradient(60% 80% at 80% 70%, color-mix(in srgb, var(--color-c3) calc(26% * var(--glow)), transparent), transparent 70%)';
const coverClass =
  'project-cover relative block aspect-[16/6] w-full overflow-hidden rounded-t-[17px] border-b border-line';
---

{/* Detalle de un proyecto (#162): portada, texto, skills como logos y su pipeline. */}
<GlassCard
  id={`proyecto-${id}`}
  data-project={id}
  hidden={hidden}
  class:list={['grid', className]}
  style={`--vt-cover: project-cover-${id}`}
>
  {hasGallery ? (
    <button
      type="button"
      data-gallery-open={id}
      aria-label={`${texts.gallery.open} ${title} (${gallery.length})`}
      class:list={[coverClass, 'cursor-zoom-in focus-visible:outline-offset-[-2px]']}
    >
      <Image
        src={gallery[0].image}
        alt=""
        widths={[600, 900, 1400]}
        sizes={sizes}
        class="absolute inset-0 size-full object-cover object-top"
      />
      <span
        aria-hidden="true"
        class="absolute right-2.5 bottom-2.5 rounded-full border border-line-hi bg-nav px-2.5 py-1.5 font-mono text-[0.7rem] leading-none text-fg backdrop-blur-md"
      >
        ⧉ {gallery.length}
      </span>
    </button>
  ) : (
    <div aria-hidden="true" class={coverClass} style={cover ? undefined : `background: ${grid};`}>
      {cover && (
        <Image
          src={cover}
          alt=""
          widths={[600, 900, 1400]}
          sizes={sizes}
          class="absolute inset-0 size-full object-cover object-top"
        />
      )}
    </div>
  )}
  <div class="grid min-[561px]:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
    <div class="project-main grid content-start gap-3 p-4">
      <p class="flex justify-between gap-3 font-mono text-[0.74rem] leading-none text-muted tabular-nums">
        <span>{year}</span>
        {featured && <span>★ {texts.featured.one}</span>}
      </p>
      <h3 class="font-display text-[clamp(1.35rem,2.6vw,1.7rem)] leading-[1.15] font-bold tracking-[-0.035em] text-balance">
        {title}
      </h3>
      <p class="text-soft">{description}</p>
      {/* Solo logos: el nombre va en `title` y para lectores de pantalla. Sin ícono, el nombre. */}
      <ul class="flex flex-wrap gap-1.5">
        {skills.map((skill) => {
          const icon = skill.icon ?? icons.get(skill.name);
          return (
            <li>
              <button
                type="button"
                data-skill={skill.name}
                aria-pressed="false"
                title={icon ? skill.name : undefined}
                class:list={[
                  'grid h-[30px] min-w-[30px] place-items-center rounded-full border border-line font-mono text-[0.74rem] leading-none text-muted transition-colors duration-300 hover:border-line-hi hover:text-fg aria-pressed:border-fg aria-pressed:bg-fg aria-pressed:text-bg',
                  icon ? 'text-[0.9rem]' : 'px-2.5',
                ]}
              >
                {icon ? (
                  <>
                    <Icon name={icon} />
                    <span class="sr-only">{skill.name}</span>
                  </>
                ) : (
                  skill.name
                )}
              </button>
            </li>
          );
        })}
      </ul>
      <ProjectLinks project={project} />
    </div>
    <ProjectPipeline project={project} />
  </div>
</GlassCard>
{hasGallery && <ProjectGallery id={id} title={title} images={gallery} labels={texts.gallery} />}

<style>
  .project-cover {
    view-transition-name: var(--vt-cover);
    view-transition-class: project-cover;
  }
  .project-main {
    view-transition-name: project-main;
  }
</style>
