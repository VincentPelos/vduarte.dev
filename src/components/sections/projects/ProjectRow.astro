---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { linkAttrs } from '../../../lib/links';
import { projectLinks, type ProjectLinkLabels } from '../../../lib/projects';
import Chip from '../../ui/Chip.astro';
import LinkHint from '../../ui/LinkHint.astro';

interface Props {
  project: CollectionEntry<'projects'>['data'];
  labels: ProjectLinkLabels;
}

const { project, labels } = Astro.props;
const { title, description, tags, image, repo, demo, caseStudy } = project;
const links = projectLinks({ caseStudy, repo, demo }, labels);

const grid =
  'linear-gradient(var(--color-glass-hi) 1px, transparent 1px) 0 0 / 12px 12px, linear-gradient(90deg, var(--color-glass-hi) 1px, transparent 1px) 0 0 / 12px 12px, var(--color-glass)';
---

<!--
  Fila de un proyecto no destacado (#107): miniatura, título, descripción a 3 líneas y chips.
  En celular, la miniatura a la izquierda y el resto apilado; desde 721px, en columnas.
-->
<li
  data-reveal
  class="grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-x-5 gap-y-2 border-b border-line px-1 py-[18px] min-[721px]:grid-cols-[96px_minmax(0,14rem)_minmax(0,1fr)_auto] min-[721px]:gap-x-7"
>
  <div
    aria-hidden="true"
    class="relative row-span-4 aspect-[4/3] self-start overflow-hidden rounded-[10px] border border-line min-[721px]:row-span-1 min-[721px]:self-center"
    style={image ? undefined : `background: ${grid};`}
  >
    {image && (
      <Image src={image} alt="" widths={[96, 192]} sizes="96px" class="size-full object-cover" />
    )}
  </div>
  <h3 class="font-display text-[1.05rem] leading-[1.25] font-bold tracking-[-0.03em]">{title}</h3>
  <p class="line-clamp-3 text-[0.92rem] text-soft">{description}</p>
  <div class="grid gap-2.5 min-[721px]:justify-items-end">
    {tags.length > 0 && (
      <ul class="flex max-w-[22rem] flex-wrap gap-1.5 min-[721px]:justify-end">
        {tags.map((tag) => (
          <Chip>{tag}</Chip>
        ))}
      </ul>
    )}
    {links.length > 0 && (
      <p class="flex flex-wrap gap-[18px] font-mono text-[0.82rem] leading-none font-medium">
        {links.map(({ href, text }) => (
          <a
            href={href}
            {...linkAttrs(href)}
            class="border-b border-line-hi pb-[3px] transition-colors hover:border-fg"
          >
            {text}
            <LinkHint href={href} />
          </a>
        ))}
      </p>
    )}
  </div>
</li>
