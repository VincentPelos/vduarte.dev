---
import { getCollection } from 'astro:content';
import skillsFile from '../../../content/skills.json';
import { getSite } from '../../../lib/content';
import { pluralize } from '../../../lib/text';
import GlassCard from '../../ui/GlassCard.astro';
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import TechIcon from '../../ui/TechIcon.astro';

const site = await getSite();

const texts = site.sections.skills;
// El loader entrega los grupos ordenados por id; se respeta el orden del JSON.
const order = skillsFile.map((group) => group.id);
const groups = (await getCollection('skills'))
  .map((entry) => entry.data)
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const total = groups.reduce((sum, group) => sum + group.items.length, 0);
const meta = `${pluralize(groups.length, texts.groups)} · ${pluralize(total, texts.items)}`;
---

<Section id="skills" constellation="skills">
  <SectionHeader file="skills.json" title={texts.title} meta={meta} constellation="skills" />
  <div class="grid grid-cols-1 gap-3 min-[521px]:grid-cols-2 min-[961px]:grid-cols-4">
    {groups.map((group) => (
      <GlassCard as="div" class="p-[22px]">
        <h3 class="label mb-4">{group.group}</h3>
        <ul class="grid gap-3">
          {group.items.map((item) => (
            <li class="flex items-center gap-3 font-medium">
              <span
                aria-hidden="true"
                class="grid size-7 flex-none place-items-center rounded-lg border border-line bg-glass text-[0.95rem]"
              >
                <TechIcon name={item.name} icon={item.icon} fallbackClass="text-[0.6rem]" />
              </span>
              {item.name}
            </li>
          ))}
        </ul>
      </GlassCard>
    ))}
  </div>
</Section>
