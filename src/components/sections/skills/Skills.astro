---
import { getCollection } from 'astro:content';
import skillsFile from '../../../content/skills.json';
import { getSite } from '../../../lib/content';
import { pluralize } from '../../../lib/text';
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import Icon from '../../ui/Icon.astro';

const site = await getSite();

const texts = site.sections.skills;
// El loader entrega los grupos ordenados por id; se respeta el orden del JSON.
const order = skillsFile.map((group) => group.id);
const groups = (await getCollection('skills'))
  .map((entry) => entry.data)
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const total = groups.reduce((sum, group) => sum + group.items.length, 0);
const meta = `${pluralize(groups.length, texts.groups)} · ${pluralize(total, texts.items)}`;
---

<Section id="skills" constellation="skills">
  <SectionHeader file="skills.json" title={texts.title} meta={meta} constellation="skills" />
  <!-- Filas sin tarjetas (#98): título del grupo con su cantidad y una línea de puntos; las
       herramientas como chips con ícono. Siempre 2 columnas; en celular, más juntas y con chips
       más chicos para acortar el scroll (#146). -->
  <div class="grid grid-cols-2 gap-x-5 gap-y-[30px] max-[460px]:gap-x-3 max-[460px]:gap-y-6 min-[901px]:gap-x-14">
    {groups.map((group) => (
      <div data-reveal class="grid min-w-0 content-start gap-3 max-[460px]:gap-2">
        <h3 class="flex items-center gap-2.5 after:h-0.5 after:flex-1 after:bg-[radial-gradient(circle,var(--color-line-hi)_1px,transparent_1.3px)] after:bg-size-[6px_2px] after:content-['']">
          <span class="label">{group.group}</span>
          <span class="font-mono text-[0.68rem] leading-none text-muted">{group.items.length}</span>
        </h3>
        <ul class="flex flex-wrap gap-1.5">
          {group.items.map((item) => (
            <li class="inline-flex max-w-full items-center gap-2 rounded-full border border-line bg-glass py-1.5 pr-3 pl-1.5 text-[0.88rem] leading-none font-medium backdrop-blur-xl max-[460px]:gap-1.5 max-[460px]:py-1 max-[460px]:pr-2 max-[460px]:pl-1 max-[460px]:text-[0.74rem] max-[460px]:leading-tight">
              <span
                aria-hidden="true"
                class="grid size-6 flex-none place-items-center rounded-full border border-line text-[0.8rem] max-[460px]:size-5 max-[460px]:text-[0.66rem]"
              >
                {/* Sin ícono de Iconify, las dos primeras letras. */}
                {item.icon ? (
                  <Icon name={item.icon} />
                ) : (
                  <span class="font-mono text-[0.55rem] font-semibold">
                    {item.name.slice(0, 2)}
                  </span>
                )}
              </span>
              {item.name}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
