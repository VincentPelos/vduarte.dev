---
import { getEntry } from 'astro:content';
import Button from '../../ui/Button.astro';

const site = await getEntry('site', 'main');
if (!site) throw new Error('Falta la entrada "main" en src/content/site.json');

const { name, role, tagline, prompt, labels, github, linkedin, cvPath } = site.data;
---

<section id="inicio" class="relative isolate overflow-hidden">
  <!--
    Fondo de respaldo: siempre visible. La animación del hero (v0.4.0) se monta encima
    en [data-hero-scene] y es intercambiable; el hero no depende de ella.
  -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-20 bg-[radial-gradient(60%_60%_at_70%_40%,color-mix(in_srgb,var(--color-c2)_25%,transparent),transparent_70%)]"
  ></div>
  <div data-hero-scene aria-hidden="true" class="absolute inset-0 -z-20"></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(90deg,var(--color-bg)_0%,color-mix(in_srgb,var(--color-bg)_55%,transparent)_45%,transparent_78%),linear-gradient(0deg,var(--color-bg)_0%,transparent_30%)]"
  ></div>

  <div class="wrap grid gap-[26px] pt-[clamp(80px,15vh,160px)] pb-[clamp(56px,10vh,100px)]">
    <p class="font-mono text-[clamp(0.78rem,2.4vw,0.92rem)] leading-[1.4] text-muted">
      <span class="text-fg">{prompt.user}</span>:~$ {prompt.command}
      <span
        aria-hidden="true"
        class="ml-0.5 inline-block h-[1.1em] w-[0.6em] animate-blink bg-fg align-[-0.2em]"
      ></span>
    </p>
    <h1 class="font-display text-name leading-[0.92] font-bold tracking-[-0.045em]">
      {name.split(' ').map((line) => (
        <span class="block">{line}</span>
      ))}
    </h1>
    <p class="text-[clamp(1.05rem,2.6vw,1.35rem)] leading-[1.3] font-semibold">{role}</p>
    <p class="max-w-[46ch] text-[clamp(1rem,2.2vw,1.15rem)] text-muted">{tagline}</p>
    <div class="flex flex-wrap gap-2.5">
      <Button href="#contacto" variant="primary" arrow="external">
        {labels.email}
      </Button>
      <Button href={github} arrow="external">
        {labels.github}
      </Button>
      <Button href={linkedin} arrow="external">
        {labels.linkedin}
      </Button>
      <Button href={cvPath} arrow="down" download>
        {labels.cv}
      </Button>
    </div>
  </div>
</section>
