---
import { getSite } from '../../../lib/content';
import Button from '../../ui/Button.astro';

const site = await getSite();

const { name, role, tagline, prompt, scrollCue, labels, github, linkedin, cvPath } = site;

// Lo que no dibuja WebGL (cursor, botones, aviso) se apaga y sube con la caída (--fall-out).
const falling = 'opacity-[calc(1-var(--fall-out,0))] translate-y-[calc(var(--fall-out,0)*-70px)]';
---

<section
  id="inicio"
  data-hero
  data-constellation-section="hero"
  class="group/hero sticky top-0 isolate z-[1] flex min-h-svh items-start overflow-hidden"
>
  <!--
    Respaldo sin WebGL: una grilla de puntos tenue en CSS (6px = CELL de lib/scene.ts), que se
    oculta con `.has-scene`. Con WebGL, el agujero negro (black-hole.ts) se monta en
    [data-hero-scene] por encima del texto y lo redibuja deformado (`.is-lensing`); el texto real
    queda transparente pero sigue ahí para lectores de pantalla. Con reduced-motion, la escena
    va detrás y el texto real queda visible.
    Es una diapositiva de pantalla completa (decisión 014). Composición horizonte: el agujero,
    quieto, cruza la parte baja y el texto va centrado arriba. Al bajar, la cámara cae en la sombra
    hasta que todo queda negro y de ahí sale el portafolio (decisión 015).
  -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle,var(--color-line)_1px,transparent_1.5px)] bg-size-[6px_6px] group-[.has-scene]/hero:hidden"
  ></div>
  <!--
    Carga del agujero negro (decisión 011): mientras se precalculan los rayos, un anillo de
    puntos se completa donde va a aparecer. Solo se ve con `.is-loading`, que pone black-hole.ts.
  -->
  <div
    aria-hidden="true"
    class="hole-loader pointer-events-none absolute top-[102%] left-1/2 -z-[5] min-[760px]:top-[112%]"
  ></div>
  <div data-hero-scene aria-hidden="true" class="pointer-events-none absolute inset-0 z-10"></div>

  <div class="wrap grid justify-items-center gap-[22px] pt-[clamp(96px,16vh,150px)] pb-16 text-center">
    <p
      data-lens
      class="font-mono text-[clamp(0.78rem,2.4vw,0.92rem)] leading-[1.4] text-muted opacity-[calc(1-var(--fall-out,0))] group-[.is-lensing]/hero:text-transparent"
    >
      <span class="text-fg group-[.is-lensing]/hero:text-transparent">{prompt.user}</span>:~${' '}
      {prompt.command}
      <span
        aria-hidden="true"
        class:list={[
          // El parpadeo pisa la opacidad: el cursor se apaga con su línea y solo sube aquí.
          'relative z-20 ml-0.5 inline-block h-[1.1em] w-[0.6em] translate-y-[calc(var(--fall-out,0)*-70px)] animate-blink bg-fg align-[-0.2em]',
        ]}
      ></span>
    </p>
    <h1
      data-lens
      class="font-display text-name leading-[0.92] font-bold tracking-[-0.045em] text-balance group-[.is-lensing]/hero:text-transparent"
    >
      <!-- Una palabra por línea en celular; desde 640px, el nombre corrido. -->
      {name.split(' ').map((line, i) => (
        <span class="block sm:inline">
          {i > 0 && <span class="hidden sm:inline"> </span>}
          {line}
        </span>
      ))}
    </h1>
    <p
      data-lens
      class="text-[clamp(1.05rem,2.6vw,1.35rem)] leading-[1.3] font-semibold group-[.is-lensing]/hero:text-transparent"
    >
      {role}
    </p>
    <p
      data-lens
      class="max-w-[46ch] text-[clamp(1rem,2.2vw,1.15rem)] text-muted group-[.is-lensing]/hero:text-transparent"
    >
      {tagline}
    </p>
    <div class:list={['relative z-20 flex flex-wrap justify-center gap-2.5', falling]}>
      <Button href="#contacto" variant="primary" arrow="down">
        {labels.email}
      </Button>
      <Button href={github} arrow="external">
        {labels.github}
      </Button>
      <Button href={linkedin} arrow="external" pendingLabel={labels.pending}>
        {labels.linkedin}
      </Button>
      <Button href={cvPath} arrow="down" download pendingLabel={labels.pending}>
        {labels.cv}
      </Button>
    </div>
  </div>
  <p
    aria-hidden="true"
    class:list={[
      'absolute bottom-[calc(18px+env(safe-area-inset-bottom,0px))] left-1/2 z-20 grid -translate-x-1/2 justify-items-center gap-1.5 font-mono text-[0.72rem] leading-none text-muted',
      falling,
    ]}
  >
    {scrollCue}
    <span class="animate-nudge text-fg">↓</span>
  </p>
</section>

<script>
  import { whenIdle } from '../../../lib/scene';

  // El agujero negro se carga diferido: no bloquea la primera pintura y, si falla, queda la
  // grilla de puntos en CSS. Cambiar la animación = cambiar black-hole.ts.
  const section = document.querySelector<HTMLElement>('[data-hero]');
  const container = section?.querySelector<HTMLElement>('[data-hero-scene]');

  if (section && container) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const load = () =>
      import('./black-hole')
        .then(({ mount }) => mount(section, container, { reducedMotion }))
        .catch(() => {});

    whenIdle(load);
  }
</script>
