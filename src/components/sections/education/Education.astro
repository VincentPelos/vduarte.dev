---
import { getCollection } from 'astro:content';
import { getSite } from '../../../lib/content';
import { sortByRecency } from '../../../lib/dates';
import { linkAttrs } from '../../../lib/links';
import LinkHint from '../../ui/LinkHint.astro';
import { pluralize } from '../../../lib/text';
import Period from '../../ui/Period.astro';
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';

const site = await getSite();

const { current, education: texts } = site.sections;
const items = sortByRecency((await getCollection('education')).map((entry) => entry.data));
const count = (type: 'degree' | 'cert' | 'training') =>
  items.filter((item) => item.type === type).length;
const meta = (['degree', 'cert', 'training'] as const)
  .filter((type) => count(type) > 0)
  .map((type) => pluralize(count(type), texts[type]))
  .join(' · ');

// Agrupados por año de inicio, del más reciente al más antiguo; dentro, por recencia.
const byYear = new Map<string, typeof items>();
for (const item of items) {
  const year = item.start?.slice(0, 4) ?? '';
  byYear.set(year, [...(byYear.get(year) ?? []), item]);
}
const years = [...byYear].sort(([a], [b]) => b.localeCompare(a));
---

<Section id="educacion" constellation="education">
  <SectionHeader file="education.json" title={texts.title} meta={meta} />
  <!--
    Línea de vida (#99): una línea de estrellas con los años de inicio grandes. Las carreras son
    estrellas grandes con la paleta y las capacitaciones, estrellas chicas.
  -->
  <ol class="relative grid max-w-[760px] gap-[26px] pl-[34px] before:absolute before:top-2 before:bottom-2 before:left-[9px] before:w-0.5 before:bg-[radial-gradient(circle,var(--color-c2)_1px,transparent_1.4px)] before:bg-size-[2px_8px] before:content-['']">
    {years.map(([year, list]) => (
      <li class="grid gap-[22px]">
        <h3 class="font-display text-[clamp(2rem,6vw,2.6rem)] leading-none font-bold tracking-[-0.05em] text-transparent [-webkit-text-stroke:1px_var(--color-muted)]">
          {year}
        </h3>
        <ul class="grid gap-[22px]">
          {list.map((item) => (
            <li
              data-reveal
              class:list={[
                'relative grid gap-1 before:absolute before:rounded-full before:content-[""]',
                item.type === 'training'
                  ? 'before:top-[0.45em] before:-left-[27px] before:size-1.5 before:bg-soft'
                  : 'before:top-[0.2em] before:-left-[31px] before:size-3.5 before:bg-[conic-gradient(var(--color-c1),var(--color-c2),var(--color-c3),var(--color-c1))] before:shadow-[0_0_0_4px_var(--color-bg)]',
              ]}
            >
              <p class="font-mono text-[0.8rem] leading-normal text-muted">
                <Period
                  start={item.start}
                  end={item.end}
                  dateNote={item.dateNote}
                  ongoing={item.ongoing}
                  currentLabel={current}
                />
              </p>
              <p
                class:list={[
                  'leading-[1.3] font-semibold',
                  item.type === 'training' ? 'text-[1rem]' : 'text-[clamp(1.1rem,2.4vw,1.3rem)]',
                ]}
              >
                {item.url ? (
                  <a href={item.url} {...linkAttrs(item.url)} class="hover:text-white">
                    {item.title}
                    <LinkHint href={item.url} />
                  </a>
                ) : (
                  item.title
                )}
              </p>
              <p class="text-[0.92rem] text-muted">
                {item.institution}
                {item.folio && ` · ${texts.folio} ${item.folio}`}
              </p>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
  <!-- Cierre de la sección: aquí las estrellas forman su símbolo (decisión 009). -->
  <div data-constellation="education" aria-hidden="true" class="mt-7 h-[150px] sm:h-[170px]"></div>
</Section>
