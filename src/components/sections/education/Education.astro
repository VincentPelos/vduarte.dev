---
import { getCollection } from 'astro:content';
import { getSite } from '../../../lib/content';
import { formatDate, groupByYear, sortByRecency } from '../../../lib/dates';
import { pluralize } from '../../../lib/text';
import Link from '../../ui/Link.astro';
import Period from '../../ui/Period.astro';
import Section from '../../ui/Section.astro';
import SectionHeader from '../../ui/SectionHeader.astro';
import YearBlock from '../../ui/YearBlock.astro';

const site = await getSite();

const texts = site.sections.education;
const items = sortByRecency((await getCollection('education')).map((entry) => entry.data));
const count = (type: 'degree' | 'cert' | 'training') =>
  items.filter((item) => item.type === type).length;
const meta = (['degree', 'cert', 'training'] as const)
  .filter((type) => count(type) > 0)
  .map((type) => pluralize(count(type), texts[type]))
  .join(' · ');
const years = groupByYear(items);
// Dentro de un año la columna ya dice el año: la capacitación muestra solo día y mes.
const dayMonth = (date: string | null) => (date ? formatDate(date).replace(/ \d{4}$/, '') : '');
---

<Section id="educacion" constellation="education">
  <SectionHeader file="education.json" title={texts.title} meta={meta} />
  <!--
    Columna de años (#134): las carreras y certificaciones con peso, una estrella grande con la
    paleta cada una; las capacitaciones de un año, juntas en un bloque compacto con una estrella
    chica. Trace.astro dibuja la línea y enciende cada estrella al entrar.
  -->
  <div data-trace class="grid gap-11">
    {years.map(([year, list], index) => {
      const studies = list.filter((item) => item.type !== 'training');
      const trainings = list.filter((item) => item.type === 'training');
      const shared = new Set(trainings.map((item) => item.institution)).size === 1;
      return (
        <YearBlock year={year} current={index === 0} line>
          {studies.map((item) => (
            <article data-trace-item class="relative grid">
              <span
                data-trace-star
                aria-hidden="true"
                class="absolute top-1.5 left-[-37px] size-3.5 rounded-full bg-[conic-gradient(var(--color-c1),var(--color-c2),var(--color-c3),var(--color-c1))] shadow-[0_0_0_4px_var(--color-bg)]"
              />
              <div data-trace-body class="veil grid gap-1.5">
                <p class="font-display text-base tracking-[-0.04em] text-grad">
                  <Period
                    start={item.start}
                    end={item.end}
                    dateNote={item.dateNote}
                    ongoing={item.ongoing}
                  />
                </p>
                <h3 class="text-[clamp(1.25rem,2.8vw,1.7rem)] leading-[1.2] font-semibold tracking-[-0.02em] text-balance">
                  {item.url ? (
                    <Link href={item.url} class="hover:text-white">
                      {item.title}
                    </Link>
                  ) : (
                    item.title
                  )}
                </h3>
                <p class="font-mono text-[0.8rem] text-muted">
                  {item.institution}
                  {item.folio && ` · ${texts.folio} ${item.folio}`}
                </p>
              </div>
            </article>
          ))}
          {trainings.length > 0 && (
            <article data-trace-item class="relative grid">
              <span
                data-trace-star
                aria-hidden="true"
                class="absolute top-[9px] left-[-33px] size-1.5 rounded-full bg-soft"
              />
              <div data-trace-body class="veil grid gap-2.5">
                <div class="flex flex-wrap items-baseline justify-between gap-x-3.5 gap-y-1">
                  <h3 class="font-semibold">{pluralize(trainings.length, texts.training)}</h3>
                  {shared && (
                    <p class="font-mono text-[0.8rem] text-muted">{trainings[0]?.institution}</p>
                  )}
                </div>
                {/* Celular (#146): tarjetas chicas de a 2; desde 561px, una fila por capacitación. */}
                <ul class="grid grid-cols-2 gap-2 min-[561px]:grid-cols-1 min-[561px]:gap-0 min-[561px]:border-t min-[561px]:border-line">
                  {trainings.map((item) => (
                    <li class="flex min-w-0 flex-col gap-1 rounded-[14px] border border-line bg-glass p-3 text-[0.86rem] leading-snug min-[561px]:grid min-[561px]:grid-cols-[4.2rem_minmax(0,1fr)_auto] min-[561px]:items-baseline min-[561px]:gap-x-3 min-[561px]:rounded-none min-[561px]:border-0 min-[561px]:border-b min-[561px]:bg-transparent min-[561px]:p-0 min-[561px]:py-2.5 min-[561px]:text-[0.92rem]">
                      <span class="font-mono text-[0.74rem] text-muted tabular-nums">
                        {dayMonth(item.start)}
                      </span>
                      <span>
                        {item.url ? (
                          <Link href={item.url} class="hover:text-white">
                            {item.title}
                          </Link>
                        ) : (
                          item.title
                        )}
                        {!shared && (
                          <span class="block text-[0.85rem] text-muted">{item.institution}</span>
                        )}
                      </span>
                      {item.folio && (
                        <span class="mt-auto font-mono text-[0.74rem] text-muted tabular-nums">
                          {texts.folio} {item.folio}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          )}
        </YearBlock>
      );
    })}
  </div>
  <!-- Cierre de la sección: aquí las estrellas forman su símbolo (decisión 009). -->
  <div data-constellation="education" aria-hidden="true" class="mt-7 h-[150px] sm:h-[170px]"></div>
</Section>
