---
import { getEntry } from 'astro:content';

const site = await getEntry('site', 'main');
if (!site) throw new Error('Falta la entrada "main" en src/content/site.json');

const year = new Date().getFullYear();
---

<!-- El padding inferior deja espacio para la nav fija. -->
<footer class="wrap flex flex-wrap justify-between gap-x-6 gap-y-2 border-t border-line pt-[26px] pb-[calc(106px+env(safe-area-inset-bottom,0px))] font-mono text-[0.76rem] leading-[1.4] text-muted">
  <span>
    © {year} {site.data.name}
  </span>
  <span>{site.data.footerNote}</span>
</footer>
