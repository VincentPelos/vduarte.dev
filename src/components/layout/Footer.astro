---
import { getSite } from '../../lib/content';

const site = await getSite();

const year = new Date().getFullYear();
---

<!-- Sólido (#130): fondo propio sobre el cielo de estrellas (z-3), a todo el ancho. -->
<footer class="relative z-[4] border-t border-line bg-bg">
  <div class="wrap flex flex-wrap justify-between gap-x-6 gap-y-2 pt-[26px] pb-[calc(26px+env(safe-area-inset-bottom,0px))] font-mono text-[0.76rem] leading-[1.4] text-muted">
    <span>
      © {year} {site.name}
    </span>
    <span class="flex flex-wrap gap-x-5 gap-y-2">
      {site.footerLinks.map((link) => (
        <a
          href={link.href}
          class="border-b border-line-hi pb-0.5 transition-colors hover:border-fg hover:text-fg"
        >
          {link.label}
        </a>
      ))}
      <span>{site.footerNote}</span>
    </span>
  </div>
</footer>
