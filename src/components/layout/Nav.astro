---
import { getSite } from '../../lib/content';

const site = await getSite();

// En el home basta con el ancla; desde otras páginas se vuelve al home.
const base = Astro.url.pathname === '/' ? '' : '/';
---

<nav
  aria-label="Secciones"
  data-nav
  class="fixed top-[calc(16px+env(safe-area-inset-top,0px))] left-1/2 z-50 max-w-[calc(100%-32px)] -translate-x-1/2 overflow-x-auto rounded-full border border-line bg-nav p-1.5 shadow-[0_10px_40px_rgb(0_0_0/0.6)] backdrop-blur-[32px] backdrop-saturate-170 [scrollbar-width:none]"
>
  <ul class="flex gap-0.5">
    {site.nav.map(({ section, label, ariaLabel }) => (
      <li>
        <a
          href={`${base}#${section}`}
          aria-label={ariaLabel}
          data-nav-section={base ? undefined : section}
          class="block rounded-full px-[15px] py-[11px] font-mono text-[0.8rem] leading-none whitespace-nowrap text-muted transition-colors hover:text-fg aria-[current=true]:bg-glass-hi aria-[current=true]:text-fg"
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Resalta la sección que cruza el centro de la pantalla. IntersectionObserver no cuesta nada
  // por cuadro; sin JS la nav funciona igual, sin resaltar. Entre secciones que no están en la nav
  // (Sobre mí) queda la última activa.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const links = new Map(
    [...(nav?.querySelectorAll<HTMLAnchorElement>('[data-nav-section]') ?? [])].map((a) => [
      a.dataset.navSection!,
      a,
    ]),
  );
  const sections = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (nav && sections.length) {
    let current: HTMLAnchorElement | undefined;
    const activate = (id: string) => {
      const link = links.get(id);
      if (!link || link === current) return;
      current?.removeAttribute('aria-current');
      link.setAttribute('aria-current', 'true');
      current = link;
      // En pantallas angostas la nav se desplaza: el enlace activo queda a la vista.
      const left = link.offsetLeft - (nav.clientWidth - link.offsetWidth) / 2;
      nav.scrollTo({ left, behavior: 'smooth' });
    };
    // El hero queda pegado arriba (decisión 014) y siempre cruza el centro: por eso se mira la
    // hoja del portafolio que lo tapa (el padre de [data-hero-end]). Mientras la hoja no llegue
    // al centro, el activo es el hero, cuya ancla `#inicio` va al principio de la página. Se mira
    // la hoja entera y no su borde de 1px: en un salto rápido (`~/`, #166) el borde cruzaba el
    // centro entre dos cuadros y el observador no se enteraba.
    const [hero] = sections;
    const sheet = document.querySelector<HTMLElement>('[data-hero-end]')?.parentElement;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.target === sheet) {
            if (!entry.isIntersecting) activate(hero.id);
          } else if (entry.isIntersecting) activate(entry.target.id);
        }
      },
      { rootMargin: '-50% 0px -50% 0px' },
    );
    sections.forEach((section) => (section !== hero || !sheet) && io.observe(section));
    if (sheet) io.observe(sheet);
  }
</script>
