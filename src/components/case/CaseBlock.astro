---
import type { CollectionEntry } from 'astro:content';
import GlassCard from '../ui/GlassCard.astro';
import BarChart from './BarChart.astro';
import FileHeading from '../ui/FileHeading.astro';

interface Props {
  block: CollectionEntry<'cases'>['data']['blocks'][number];
}

// Un hallazgo: titular, la cifra contada en una frase y uno o dos gráficos con su fuente.
const { block } = Astro.props;
---

<section id={block.id} class="mt-[clamp(56px,8vw,90px)] scroll-mt-24">
  <FileHeading file={block.file} title={block.title} />
  <p class="mt-2 mb-[22px] max-w-[70ch] text-soft">{block.take}</p>
  <div class:list={['grid gap-3', block.panels.length > 1 && 'min-[861px]:grid-cols-2']}>
    {block.panels.map((panel) => (
      <GlassCard as="div" class="grid min-w-0 content-start gap-3 p-[18px]">
        <h3 class="text-[0.98rem] font-semibold">{panel.title}</h3>
        <BarChart chart={panel.chart} />
        <p class="font-mono text-[0.7rem] leading-[1.4] text-muted">{panel.source}</p>
      </GlassCard>
    ))}
  </div>
</section>
