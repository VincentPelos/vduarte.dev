---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import GlassCard from '../ui/GlassCard.astro';
import FileHeading from '../ui/FileHeading.astro';

interface Props {
  data: CollectionEntry<'cases'>['data'];
}

// El Power BI no se puede incrustar sin licencia (decisión 006): sus páginas en grande y la descarga.
const { data } = Astro.props;
const { dashboard, gallery, resources, labels } = data;
---

<section id="dashboard" class="mt-[clamp(56px,8vw,90px)] scroll-mt-24">
  <FileHeading file="dashboard/colchagua_cereza.pbix" title={dashboard.title} />
  <p class="mt-2 mb-[22px] max-w-[70ch] text-soft">{dashboard.take}</p>
  <div class="grid gap-3 min-[861px]:grid-cols-[2fr_1fr]">
    {gallery.map((shot, i) => (
      <GlassCard
        as="div"
        class:list={['grid overflow-hidden', i === 0 && 'min-[861px]:row-span-2']}
      >
        <Image
          src={shot.image}
          alt={shot.alt}
          widths={[480, 960, 1440]}
          sizes={i === 0 ? '(min-width: 861px) 66vw, 100vw' : '(min-width: 861px) 33vw, 100vw'}
          class="size-full max-h-[440px] bg-white object-contain"
        />
        <p class="border-t border-line px-3.5 py-2.5 font-mono text-[0.76rem] leading-[1.4] text-muted">
          {shot.caption}
        </p>
      </GlassCard>
    ))}
  </div>
  <div class="mt-3 flex flex-wrap gap-2.5">
    <Button href={resources.dashboard} variant="primary" arrow="down" download>
      {labels.download}
    </Button>
    <Button href={resources.report} arrow="external">
      {labels.report}
    </Button>
  </div>
</section>
