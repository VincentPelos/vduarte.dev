---
import { getIconNames } from '../../lib/content';
import { iconSymbol } from '../../lib/icons';

interface Props {
  /** Nombre de Iconify con prefijo, p. ej. `"simple-icons:python"`. */
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
const { id, width, height } = iconSymbol(name);

// El dibujo vive una sola vez en el sprite (IconSprite); aquí solo se referencia.
if (!(await getIconNames()).includes(name)) {
  throw new Error(`El ícono "${name}" no está en el sprite: agrégalo a skills.json`);
}
---

<svg aria-hidden="true" fill="currentColor" width={width} height={height} class={className}>
  <use href={`#${id}`} />
</svg>
