---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href?: string;
  variant?: 'primary' | 'glass';
  pendingLabel?: string;
  /** Flecha al final: `external` (↗) para enlaces fuera del sitio, `down` (↓) para descargas. */
  arrow?: 'external' | 'down';
}

const { href, variant = 'glass', pendingLabel, arrow, class: className, ...attrs } = Astro.props;
const isExternal = href ? /^https?:\/\//.test(href) : false;
const arrows = { external: '↗', down: '↓' };
const classes = [
  'group inline-flex items-center gap-2 rounded-full border px-[18px] py-[13px] text-[0.88rem] leading-none transition',
  variant === 'primary'
    ? 'border-fg bg-fg font-semibold text-bg'
    : 'border-line bg-glass font-medium backdrop-blur-xl',
  href &&
    (variant === 'primary'
      ? 'hover:bg-white'
      : 'hover:-translate-y-px hover:border-line-hi hover:bg-glass-hi'),
  !href && 'cursor-not-allowed opacity-70',
  className,
];
---

{href ? (
  <a
    href={href}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener' : undefined}
    class:list={classes}
    {...attrs}
  >
    <slot />
    {arrow && (
      <span
        aria-hidden="true"
        class="font-mono transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      >
        {arrows[arrow]}
      </span>
    )}
  </a>
) : (
  <span role="link" aria-disabled="true" title={pendingLabel} class:list={classes}>
    <slot />
    {arrow && (
      <span aria-hidden="true" class="font-mono">
        {arrows[arrow]}
      </span>
    )}
  </span>
)}
