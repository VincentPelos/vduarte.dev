---
import type { HTMLAttributes } from 'astro/types';
import Link from './Link.astro';

interface Props extends HTMLAttributes<'a'> {
  href?: string;
  variant?: 'primary' | 'glass';
  pendingLabel?: string;
  /** Flecha al final: `external` (↗) para enlaces fuera del sitio, `down` (↓) para descargas o secciones más abajo. */
  arrow?: 'external' | 'down';
}

const { href, variant = 'glass', pendingLabel, arrow, class: className, ...attrs } = Astro.props;
const arrows = { external: '↗', down: '↓' };
// Sin `href`, el botón queda pendiente: enfocable para que el teclado y los lectores de pantalla
// lo encuentren y anuncien que falta.
const classes = [
  'group inline-flex items-center gap-2 rounded-full border px-[18px] py-[13px] text-[0.88rem] leading-none transition',
  variant === 'primary'
    ? 'border-fg bg-fg font-semibold text-bg'
    : 'border-line bg-glass font-medium backdrop-blur-xl',
  href &&
    (variant === 'primary'
      ? 'hover:bg-white'
      : 'hover:-translate-y-px hover:border-line-hi hover:bg-glass-hi'),
  !href && 'cursor-not-allowed opacity-70',
  className,
];
---

{href ? (
  <Link href={href} class:list={classes} {...attrs}>
    <slot />
    {arrow && (
      <span
        aria-hidden="true"
        class="font-mono transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      >
        {arrows[arrow]}
      </span>
    )}
  </Link>
) : (
  <span role="link" aria-disabled="true" tabindex="0" title={pendingLabel} class:list={classes}>
    <slot />
    {pendingLabel && <span class="sr-only"> ({pendingLabel})</span>}
    {arrow && (
      <span aria-hidden="true" class="font-mono">
        {arrows[arrow]}
      </span>
    )}
  </span>
)}
