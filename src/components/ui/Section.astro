---
interface Props {
  id: string;
  class?: string;
  /** Nombre de la sección para la cinemática de constelaciones (decisión 009). */
  constellation?: string;
}

const { id, class: className, constellation } = Astro.props;
---

<section
  id={id}
  data-constellation-section={constellation}
  class:list={['border-t border-line py-[clamp(48px,12vw,140px)]', className]}
>
  <div class="wrap">
    <slot />
  </div>
</section>
