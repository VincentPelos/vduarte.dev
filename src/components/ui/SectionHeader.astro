---
interface Props {
  /** JSON de `src/content/` del que sale la sección, mostrado como `$ cat src/content/<file>`. */
  file: string;
  title: string;
  meta?: string;
  /** Si se indica, deja junto al título el lugar donde las estrellas forman su símbolo. */
  constellation?: string;
}

const { file, title, meta, constellation } = Astro.props;
---

<header class="mb-[clamp(36px,6vw,60px)] grid grid-cols-[minmax(0,1fr)_auto] items-end gap-x-6 gap-y-2.5">
  <div class="grid gap-2.5">
    <p class="font-mono text-[0.78rem] leading-[1.3] text-muted">
      $ cat <span class="text-fg">src/content/{file}</span>
    </p>
    <h2 class="font-display text-section leading-none font-bold tracking-display">{title}</h2>
    {meta && <p class="font-mono text-[0.78rem] leading-none text-muted">{meta}</p>}
  </div>
  {constellation && (
    <div
      data-constellation={constellation}
      aria-hidden="true"
      class="h-[90px] w-[120px] sm:h-[130px] sm:w-[220px]"
    />
  )}
</header>
