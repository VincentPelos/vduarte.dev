---
interface Props {
  /** Multiplica `--glow`; la sección de contacto usa uno más tenue. */
  strength?: number;
  class?: string;
}

const { strength = 0.55, class: className } = Astro.props;
---

{/*
  Brillos difuminados detrás del vidrio. El padre necesita `relative`; con `isolate` quedan
  dentro de la sección, sin él pasan por detrás de las secciones vecinas.
  Cada brillo es un degradado (`glow-orb`), no un `filter: blur`, y quedan quietos: animados
  dentro de la máscara, la GPU recomponía la máscara y el vidrio de encima en cada cuadro (#192,
  docs/02-arquitectura/rendimiento.md). Cada uno queda en un punto distinto del antiguo `drift`.
*/}
<div
  aria-hidden="true"
  class:list={[
    'pointer-events-none absolute -inset-x-[5%] -inset-y-[10%] -z-10 [mask-image:linear-gradient(transparent,#000_25%,#000_75%,transparent)]',
    className,
  ]}
  style={`opacity: calc(${strength} * var(--glow));`}
>
  <span class="absolute top-[10%] left-[2%] aspect-square w-[38%] [transform:translate(2%,-3%)_scale(1.05)] glow-orb [--orb:var(--color-c1)]"></span>
  <span class="absolute top-[45%] left-[40%] aspect-square w-[32%] [transform:translate(4%,-5%)_scale(1.1)] glow-orb [--orb:var(--color-c2)]"></span>
  <span class="absolute top-0 right-0 aspect-square w-[30%] [transform:translate(6%,-8%)_scale(1.15)] glow-orb [--orb:var(--color-c3)]"></span>
</div>
