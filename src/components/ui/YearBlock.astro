---
interface Props {
  year: string;
  /** El año más reciente va con el degradado de la paleta; los demás, en contorno. */
  current?: boolean;
  /**
   * Línea punteada propia (Educación). Experiencia no la lleva: su línea es la constelación
   * que dibuja el cielo (decisión 009).
   */
  line?: boolean;
}

const { year, current = false, line = false } = Astro.props;
---

{/*
  Columna de años (#134): desde 721px el año queda fijo a la izquierda mientras pasan sus
  entradas. La línea va 31px a la izquierda de las entradas, a la misma altura en celular y en
  escritorio, y las estrellas de cada entrada se alinean con ella.
*/}
<div class="grid gap-4 pl-10 min-[721px]:grid-cols-[10rem_minmax(0,1fr)] min-[721px]:gap-x-9 min-[721px]:pl-0">
  <p
    aria-hidden="true"
    class:list={[
      'font-display text-[clamp(2.2rem,6vw,3.4rem)] leading-none font-bold tracking-[-0.05em] min-[721px]:sticky min-[721px]:top-24 min-[721px]:self-start',
      current ? 'text-grad' : 'text-transparent [-webkit-text-stroke:1px_var(--color-muted)]',
    ]}
  >
    {year}
  </p>
  <div class="relative grid min-w-0 gap-[30px] min-[721px]:pl-10">
    {line && (
      <span
        data-trace-line
        aria-hidden="true"
        class="absolute top-1.5 bottom-1.5 left-[-31px] w-0.5 origin-top bg-[radial-gradient(circle,var(--color-c2)_1px,transparent_1.4px)] bg-size-[2px_8px] min-[721px]:left-[9px]"
      />
    )}
    <slot />
  </div>
</div>
