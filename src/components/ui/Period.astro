---
import { getSite } from '../../lib/content';
import { periodParts } from '../../lib/dates';

interface Props {
  start: string | null;
  end: string | null;
  dateNote?: string;
  ongoing?: boolean;
}

const { start, end, dateNote, ongoing } = Astro.props;
// Lo que se muestra en lugar del término de un periodo vigente.
const currentLabel = (await getSite()).sections.current;
const { from, to, current } = periodParts(start, end, { dateNote, ongoing });
---

<span class="tabular-nums">
  {from}
  {(to || current) && <span aria-hidden="true">{' → '}</span>}
  {to}
  {current && <span class="text-ok">{currentLabel}</span>}
</span>
