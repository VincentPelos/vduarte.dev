---
import { periodParts } from '../../lib/dates';

interface Props {
  start: string | null;
  end: string | null;
  dateNote?: string;
  ongoing?: boolean;
  /** Texto para un periodo vigente (`sections.current` de site.json). */
  currentLabel: string;
}

const { start, end, dateNote, ongoing, currentLabel } = Astro.props;
const { from, to, current } = periodParts(start, end, { dateNote, ongoing });
---

<span class="tabular-nums">
  {from}
  {(to || current) && <span aria-hidden="true">{' → '}</span>}
  {to}
  {current && <span class="text-ok">{currentLabel}</span>}
</span>
