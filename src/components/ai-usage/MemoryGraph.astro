---
import { getAiUsage } from '../../lib/content';
import { pluralize } from '../../lib/text';
import FileHeading from '../ui/FileHeading.astro';
import GlassCard from '../ui/GlassCard.astro';
import Link from '../ui/Link.astro';
import { memoryGraph, type NoteKind } from './memory-graph';

// Las notas de docs/ se leen en el build; la página no las publica, solo el grafo.
const files = Object.fromEntries(
  Object.entries(
    import.meta.glob<string>('/docs/**/*.md', { query: '?raw', import: 'default', eager: true }),
  ).map(([path, source]) => [path.replace(/^\/docs\//, ''), source]),
);
const { width, height, nodes, edges } = memoryGraph(files);
const { memory } = await getAiUsage();
const kinds: NoteKind[] = ['decision', 'log', 'note', 'index'];
const count = (kind: NoteKind) => nodes.filter((node) => node.kind === kind).length;
// Tres tamaños de punto (· • ●), según cuántas notas enlaza.
const size = (degree: number) => (degree >= 12 ? 12 : degree >= 5 ? 8 : 5);
---

{/*
  Grafo de la memoria (#177): las aristas en un SVG y cada nota como un enlace encima, en
  porcentaje de la caja, así los puntos no se achican en celular y el foco funciona con teclado.
  Sin JS se ve el grafo completo y cada punto abre su nota.
*/}
<section id="memoria" class="mt-[clamp(56px,8vw,90px)]">
  <FileHeading file={memory.file} title={memory.title} />
  <p class="mt-3 max-w-[68ch] text-[0.95rem] text-soft">{memory.text}</p>
  <GlassCard class="mt-[22px] p-[clamp(10px,2vw,18px)]">
    <p class="flex flex-wrap justify-between gap-x-4 gap-y-1 font-mono text-[0.72rem] leading-[1.4] text-muted">
      <span data-memory-idle>
        {pluralize(nodes.length, memory.notes)} · {pluralize(edges.length, memory.links)}
      </span>
      <span data-memory-active hidden>
        $ cat <span data-memory-path class="text-fg"></span>
      </span>
      <span data-memory-active data-memory-degree hidden class="tabular-nums"></span>
    </p>
    <p
      data-memory-title
      aria-hidden="true"
      class="mt-1 min-h-[1.3em] font-display text-[clamp(0.85rem,2vw,1.05rem)] leading-tight font-bold tracking-display text-pretty"
    ></p>
    <div data-memory class="memory relative mt-2" style={`aspect-ratio: ${width} / ${height}`}>
      <svg
        aria-hidden="true"
        class="absolute inset-0 size-full overflow-visible"
        viewBox={`0 0 ${width} ${height}`}
        preserveAspectRatio="none"
      >
        {edges.map(([a, b]) => (
          <line
            data-edge
            data-a={a}
            data-b={b}
            x1={nodes[a]!.x}
            y1={nodes[a]!.y}
            x2={nodes[b]!.x}
            y2={nodes[b]!.y}
            vector-effect="non-scaling-stroke"
          />
        ))}
      </svg>
      <ul>
        {nodes.map((node, i) => (
          <li>
            <Link
              href={memory.repo + node.path}
              data-node={i}
              data-path={`docs/${node.path}`}
              data-title={node.title}
              data-degree={pluralize(node.degree, memory.links)}
              data-kind={node.kind}
              class="node absolute block -translate-1/2 rounded-full"
              style={`left: ${(node.x / width) * 100}%; top: ${(node.y / height) * 100}%; --size: ${size(node.degree)}px`}
            >
              <span class="sr-only">{node.title}</span>
            </Link>
          </li>
        ))}
      </ul>
    </div>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-x-5 gap-y-2 font-mono text-[0.72rem] text-muted">
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        {kinds.map((kind) => (
          <li class="flex items-center gap-1.5">
            <span aria-hidden="true" data-kind={kind} class="node-swatch size-[7px] rounded-full" />
            {memory.kinds[kind]} <span class="tabular-nums">{count(kind)}</span>
          </li>
        ))}
      </ul>
      <span>{memory.hint}</span>
    </div>
  </GlassCard>
</section>

<style>
  [data-kind='decision'] {
    --kind: var(--color-c2);
  }
  [data-kind='log'] {
    --kind: var(--color-c3);
  }
  [data-kind='note'] {
    --kind: var(--color-c1);
  }
  [data-kind='index'] {
    --kind: var(--color-fg);
  }
  .node-swatch {
    background: var(--kind);
  }
  line {
    stroke: var(--color-line-hi);
    stroke-width: 1;
    stroke-dasharray: 1 4;
    stroke-linecap: round;
  }
  .node {
    width: var(--size);
    height: var(--size);
    background: var(--kind);
  }
  /* Área de toque más grande que el punto, para el dedo. */
  .node::before {
    content: '';
    position: absolute;
    inset: -9px;
    border-radius: inherit;
  }
  .node:focus-visible {
    outline: 1px solid var(--color-fg);
    outline-offset: 3px;
  }
  /* Con una nota elegida (memory-graph en el script), se apaga todo lo que no la toca. */
  .memory[data-active] .node:not([data-on]) {
    opacity: 0.2;
  }
  .memory[data-active] line:not([data-on]) {
    opacity: 0.15;
  }
  .memory line[data-on] {
    stroke: var(--color-fg);
    stroke-dasharray: none;
  }
  .node[data-current] {
    scale: 1.6;
  }
  @media (prefers-reduced-motion: no-preference) {
    .node,
    line {
      transition:
        opacity 300ms var(--ease-out-expo),
        scale 300ms var(--ease-out-expo);
    }
  }
</style>

<script>
  // Al pasar el mouse o enfocar una nota, se encienden ella, sus vecinas y sus enlaces, y arriba
  // se lee su ruta y su título.
  const box = document.querySelector<HTMLElement>('[data-memory]');
  if (box) {
    const card = box.parentElement!;
    const nodes = [...box.querySelectorAll<HTMLElement>('[data-node]')];
    const lines = [...box.querySelectorAll<SVGLineElement>('[data-edge]')];
    const idle = card.querySelectorAll<HTMLElement>('[data-memory-idle]');
    const active = card.querySelectorAll<HTMLElement>('[data-memory-active]');
    const path = card.querySelector<HTMLElement>('[data-memory-path]')!;
    const degree = card.querySelector<HTMLElement>('[data-memory-degree]')!;
    const title = card.querySelector<HTMLElement>('[data-memory-title]')!;

    const clear = () => {
      delete box.dataset.active;
      for (const el of [...nodes, ...lines]) {
        el.removeAttribute('data-on');
        el.removeAttribute('data-current');
        el.removeAttribute('data-shown');
      }
      idle.forEach((el) => (el.hidden = false));
      active.forEach((el) => (el.hidden = true));
      title.textContent = '';
    };

    const show = (node: HTMLElement) => {
      clear();
      const i = node.dataset.node!;
      box.dataset.active = '';
      node.dataset.current = '';
      node.dataset.on = '';
      for (const line of lines) {
        const { a, b } = line.dataset;
        if (a !== i && b !== i) continue;
        line.dataset.on = '';
        nodes[Number(a === i ? b : a)]!.dataset.on = '';
      }
      idle.forEach((el) => (el.hidden = true));
      active.forEach((el) => (el.hidden = false));
      path.textContent = node.dataset.path!;
      degree.textContent = node.dataset.degree!;
      title.textContent = node.dataset.title!;
    };

    let touch = false;
    box.addEventListener('pointerdown', (event) => (touch = event.pointerType !== 'mouse'));
    for (const node of nodes) {
      node.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') show(node);
      });
      // Con el dedo no hay hover: el primer toque muestra la nota y el segundo la abre.
      node.addEventListener('click', (event) => {
        if (!touch || node.hasAttribute('data-shown')) return;
        event.preventDefault();
        show(node);
        node.dataset.shown = '';
      });
      node.addEventListener('focus', () => show(node));
      node.addEventListener('blur', clear);
    }
    box.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') clear();
    });
  }
</script>
