{
  "name": "vduarte.dev",
  "type": "module",
  "version": "0.3.1",
  "private": true,
  "description": "Portafolio de Vicente Contreras Duarte, desarrollador de software y soporte TI.",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@iconify-json/simple-icons": "^1.2.99",
    "@iconify/utils": "^3.1.7",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/styles/global.css",
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        72
      ],
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "style",
          "refactor",
          "docs",
          "test",
          "chore",
          "ci",
          "perf",
          "release"
        ]
      ],
      "scope-enum": [
        1,
        "always",
        [
          "hero",
          "bento",
          "experiencia",
          "proyectos",
          "skills",
          "educacion",
          "contacto",
          "nav",
          "caso",
          "contenido",
          "diseno",
          "particulas",
          "animaciones",
          "seo",
          "ci",
          "deps",
          "boveda",
          "proyecto",
          "arquitectura",
          "decisiones",
          "git",
          "bitacora"
        ]
      ]
    }
  }
}
